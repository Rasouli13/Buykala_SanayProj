@baseUrl = http://localhost:1234
@contentType = application/json

### ۱. ثبت‌نام کاربر جدید با نقش غرفه‌دار (Vendor)
# @name registerVendor
POST {{baseUrl}}/api/users/register
Content-Type: {{contentType}}

{
    "phoneNumber": "09123456789",
    "password": "securePassword123",
    "role": "VENDOR"
}

### ۲. ثبت‌نام کاربر جدید با نقش ادمین (Admin)
# @name registerAdmin
POST {{baseUrl}}/api/users/register
Content-Type: {{contentType}}

{
    "phoneNumber": "09999999999",
    "password": "adminPassword123",
    "role": "ADMIN"
}


### ۳. ارسال درخواست ایجاد غرفه توسط کاربر غرفه‌دار
# توجه: شناسه کاربر (X-User-Id) بر اساس فیلد id تولید شده در درخواست اول باید ست شود (مثلاً 1)
POST {{baseUrl}}/api/shops
Content-Type: {{contentType}}
X-User-Id: 1

{
    "name": "غرفه دیجیتال کالا",
    "shabaNumber": "IR123456789012345678901234"
}

### ۴. تایید غرفه توسط ادمین (تغییر وضعیت به APPROVED)
# توجه: شناسه غرفه (shopId) بر اساس آی‌دی تولید شده در درخواست سوم ست شود (مثلاً 1)
PATCH {{baseUrl}}/api/shops/1/status?status=APPROVED
Content-Type: {{contentType}}

### ۵. رد غرفه توسط ادمین (تغییر وضعیت به REJECTED)
PATCH {{baseUrl}}/api/shops/1/status?status=REJECTED
Content-Type: {{contentType}}

###
GET  {{baseUrl}}/api/users
Content-Type: {{contentType}}


### ۷. دریافت لیست تمامی غرفه‌ها (Shops)
GET {{baseUrl}}/api/shops/all
Content-Type: {{contentType}}


### ۸. ایجاد دسته‌بندی جدید توسط ادمین
POST {{baseUrl}}/api/categories
Content-Type: {{contentType}}

{
    "name": "کالای دیجیتال"
}

### ۹. دریافت لیست دسته‌بندی‌ها (برای برداشتم ID دسته‌بندی)
GET {{baseUrl}}/api/categories
Content-Type: {{contentType}}

### ۱۰. ایجاد محصول جدید توسط غرفه‌دار
# توجه ۱: شناسه کاربر غرفه‌دار (X-User-Id) باید هدر داده شود (مثلاً 1)
# توجه ۲: این غرفه ابتدا باید در مرحله ۴ فاز اول APPROVED شده باشد، در غیر این صورت خطا می‌دهد.
POST {{baseUrl}}/api/products
Content-Type: {{contentType}}
X-User-Id: 1

{
    "name": "گوشی موبایل گلکسی S24",
    "description": "نسخه ۲۵۶ گیگابایت همراه با گارانتی",
    "price": 55000000,
    "stock": 15,
    "categoryId": 1
}

### ۱۱. دریافت تمام محصولات فروشگاه
GET {{baseUrl}}/api/products
Content-Type: {{contentType}}

### ۱۲. دریافت محصولات غرفه شماره ۱
GET {{baseUrl}}/api/products/shop/1
Content-Type: {{contentType}}


### ۱۳. ثبت‌نام یک کاربر جدید به عنوان مشتری (Customer)
POST {{baseUrl}}/api/users/register
Content-Type: {{contentType}}

{
    "phoneNumber": "09111111111",
    "password": "customerPassword123",
    "role": "CUSTOMER"
}

### ۱۴. ثبت آدرس پستی برای مشتری جدید
# توجه: هدر X-User-Id باید شناسه مشتری ثبت‌شده در مرحله قبل باشد (مثلاً 3)
POST {{baseUrl}}/api/addresses
Content-Type: {{contentType}}
X-User-Id: 3

{
    "title": "Home Address",
    "addressLine": "No 42, West Baker St",
    "city": "Tehran",
    "postalCode": "1234567890"
}

### ۱۵. اضافه کردن کالا به سبد خرید توسط مشتری
# توجه: شناسه محصول (productId) را از خروجی‌های فاز ۲ جایگذاری کنید (مثلاً 1)
POST {{baseUrl}}/api/cart
Content-Type: {{contentType}}
X-User-Id: 3

{
    "productId": 1,
    "quantity": 2
}

### ۱۶. مشاهده اقلام داخل سبد خرید مشتری
GET {{baseUrl}}/api/cart
Content-Type: {{contentType}}
X-User-Id: 3

### ۱۷. نهایی کردن سبد خرید و صدور فاکتور سفارش (Checkout)
# توجه: شناسه آدرس (addressId) را از مرحله ۱۴ قرار دهید (مثلاً 1)
POST {{baseUrl}}/api/orders/checkout
Content-Type: {{contentType}}
X-User-Id: 3

{
    "addressId": 1
}

### ۱۸. تغییر وضعیت سفارش به SHIPPED توسط غرفه‌دار
# توجه: شناسه سفارش (orderId) را از فاکتور مرحله ۱۷ قرار دهید (مثلاً 1)
PATCH {{baseUrl}}/api/orders/1/status?status=SHIPPED
Content-Type: {{contentType}}